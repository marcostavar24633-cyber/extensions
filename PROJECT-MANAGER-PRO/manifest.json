{
  "manifest_version": 3,
  "name": "PROJECT MANAGER PRO — Chat & GitHub",
  "version": "1.10.1",
  "description": "PROJECT MANAGER PRO: обновление одной кнопкой через локальный помощник и GitHub; исправлена отправка названия проекта в новый чат.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "activeTab",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_title": "Открыть PROJECT MANAGER PRO"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
